const VISIBLE_ROWS = 3;
const CARDS_PER_ROW = 4;
const VISIBLE_COUNT = VISIBLE_ROWS * CARDS_PER_ROW;
let speakersExpanded = false;

function initials(name) {
    return name.split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase();
}

function renderSpeakers() {
    const grid = document.getElementById('speakersGrid');
    grid.innerHTML = '';

    SPEAKERS.forEach((sp, i) => {
        const card = document.createElement('div');
        card.className = 'speaker-card' + (i >= VISIBLE_COUNT ? ' hidden' : '');

        const photo = document.createElement('div');
        photo.className = 'speaker-photo';
        photo.style.background = `linear-gradient(135deg, ${sp.color}, #2e2e3a)`;
        photo.textContent = initials(sp.name);

        const info = document.createElement('div');
        info.className = 'speaker-info';

        const name = document.createElement('div');
        name.className = 'speaker-name';
        name.textContent = sp.name;

        const role = document.createElement('div');
        role.className = 'speaker-role';
        role.textContent = sp.role;

        const logo = document.createElement('div');
        logo.className = 'speaker-logo';
        logo.textContent = sp.company;

        info.appendChild(name);
        info.appendChild(role);
        info.appendChild(logo);

        card.appendChild(photo);
        card.appendChild(info);
        grid.appendChild(card);
    });

    const btn = document.getElementById('showAllBtn');
    btn.style.display = SPEAKERS.length > VISIBLE_COUNT ? 'block' : 'none';
    btn.textContent = speakersExpanded ? 'Скрыть' : 'Показать всех';
}

function showAllSpeakers() {
    speakersExpanded = !speakersExpanded;
    document.querySelectorAll('.speaker-card').forEach((card, i) => {
        card.classList.toggle('hidden', !speakersExpanded && i >= VISIBLE_COUNT);
    });
    document.getElementById('showAllBtn').textContent =
        speakersExpanded ? 'Скрыть' : 'Показать всех';
}

/* ============================================================
   РОЗЫГРЫШ
   ============================================================ */

let participantCounter = 0;

function registerParticipant(event) {
    event.preventDefault();

    const name    = document.getElementById('lotName').value.trim();
    const email   = document.getElementById('lotEmail').value.trim();
    const phone   = document.getElementById('lotPhone').value.trim();
    const company = document.getElementById('lotCompany').value.trim();

    if (!name || !email || !phone || !company) return;

    participantCounter++;
    const number = String(participantCounter).padStart(5, '0');

    const result = document.getElementById('lotteryResult');
    document.getElementById('participantNumber').textContent = number;
    result.style.display = 'block';

    // Очищаем форму
    document.getElementById('lotteryForm').reset();

    // Плавно прокручиваем к результату
    result.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

/* ============================================================
   ИНИЦИАЛИЗАЦИЯ
   ============================================================ */
buildTicker(CHANNELS.main.schedule);
renderSpeakers();
</script>
