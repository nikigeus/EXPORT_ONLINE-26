        name: 'Студия 1',
        url: 'https://my.mts-link.ru/j/ExportCenter/26994350461',
        schedule: [
            { time: '12:10', title: 'Интервью с инфлюенсерами из Китая: продвижение и работа с аудиторией' },
            { time: '13:10', title: '' },
            { time: '15:10', title: 'СертифИИ-инструмент(ы) или аналитика' },
            { time: '16:40', title: 'Работа на электронных площадках' }
        ]
    },
    studio2: {
        name: 'Студия 2',
        url: 'https://my.mts-link.ru/j/ExportCenter/26998089723',
        schedule: [
            { time: '12:10', title: 'База знаний' },
            { time: '13:10', title: 'Дебаты' },
            { time: '15:10', title: 'Платежи' },
            { time: '16:40', title: 'Логистика' }
        ]
    }
};

let activeChannel = 'main';

/* ============================================================
   ПЕРЕКЛЮЧЕНИЕ КАНАЛОВ
   ============================================================ */
function selectChannel(key) {
    if (key === activeChannel) return;
    activeChannel = key;
    const ch = CHANNELS[key];

    // Плеер
    document.getElementById('streamFrame').src = ch.url;
    document.getElementById('nowPlaying').textContent = ch.name;

    // Активная кнопка
    document.querySelectorAll('.channel-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.channel === key);
    });

    // Расписание
    document.getElementById('scheduleChannel').textContent = ch.name;
    buildTicker(ch.schedule);
}

/* ============================================================
   БЕГУЩАЯ СТРОКА
   ============================================================ */

const LINE_LIMIT = 25;          // максимум символов в одной строке
const TICKER_SPEED = 60;        // пикселей в секунду

let tickerAnimation = null;
let tickerOffset = 0;
let tickerContentWidth = 0;
let lastFrameTime = null;

/* Разбивает название на 2 строки по 25 символов.
   Возвращает { line2, line3, overflow } */
function splitTitle(title) {
    const t = title.trim();
    if (!t) return { line2: '', line3: '', overflow: false };

    if (t.length <= LINE_LIMIT) {
        return { line2: t, line3: '', overflow: false };
    }

    let first = t.slice(0, LINE_LIMIT);
    let rest = t.slice(LINE_LIMIT);

    // Не разрываем слово посередине, если можно перенести его целиком
    if (rest.length > 0 && t[LINE_LIMIT - 1] !== ' ' && t[LINE_LIMIT] !== ' ') {
        const lastSpace = first.lastIndexOf(' ');
        if (lastSpace > 0) {
            first = t.slice(0, lastSpace);
            rest = t.slice(lastSpace + 1);
        }
    }
    first = first.trimEnd();

    if (rest.length <= LINE_LIMIT) {
        return { line2: first, line3: rest, overflow: false };
    }

    // Не влезает и в третью строку — обрываем с многоточием
    let second = rest.slice(0, LINE_LIMIT - 1).trimEnd();
    return { line2: first, line3: second + '…', overflow: true };
}

/* Создаёт DOM-элемент одной сессии бегущей строки */
function createTickerItem(session) {
    const { line2, line3, overflow } = splitTitle(session.title);

    const item = document.createElement('div');
    item.className = 'ticker-item';

    const time = document.createElement('div');
    time.className = 't-time';
    time.textContent = session.time;
    item.appendChild(time);

    const titleWrap = document.createElement('div');
    titleWrap.className = 't-title-wrap';
    if (overflow) titleWrap.dataset.full = session.title;

    const l2 = document.createElement('div');
    l2.className = 't-line t-line-2';
    l2.textContent = line2 || '\u00A0';
    titleWrap.appendChild(l2);

    if (line3) {
        const l3 = document.createElement('div');
        l3.className = 't-line t-line-3';
        l3.textContent = line3;
        titleWrap.appendChild(l3);
    } else {
        // Пустая третья строка нужна, чтобы высота элемента была стабильной
        const l3 = document.createElement('div');
        l3.className = 't-line t-line-3';
        l3.textContent = '\u00A0';
        titleWrap.appendChild(l3);
    }

    item.appendChild(titleWrap);
    return item;
}

function createSeparator() {
    const sep = document.createElement('div');
    sep.className = 'ticker-sep';
    sep.textContent = '•';
    return sep;
}

/* Полностью пересобирает ленту под расписание выбранного канала */
function buildTicker(schedule) {
    const track = document.getElementById('tickerTrack');
    track.innerHTML = '';

    if (!schedule || schedule.length === 0) return;

    // Строим один набор сессий с точками-разделителями
    const buildSet = () => {
        const frag = document.createDocumentFragment();
        schedule.forEach(s => {
            frag.appendChild(createTickerItem(s));
            frag.appendChild(createSeparator());
        });
        return frag;
    };

    track.appendChild(buildSet());
    // Дублируем набор для бесшовного зацикливания
    track.appendChild(buildSet());

    // Сбрасываем анимацию
    if (tickerAnimation) cancelAnimationFrame(tickerAnimation);
    tickerOffset = 0;
    lastFrameTime = null;

    // Ждём кадр, чтобы измерить ширину одного набора
    requestAnimationFrame(() => {
        const children = track.children;
        const half = children.length / 2;
        let width = 0;
        for (let i = 0; i < half; i++) {
            width += children[i].getBoundingClientRect().width;
        }
        tickerContentWidth = width;
        tickerAnimation = requestAnimationFrame(animateTicker);
    });
}

/* Анимация: движение справа налево с зацикливанием */
function animateTicker(timestamp) {
    if (lastFrameTime === null) lastFrameTime = timestamp;
    const dt = (timestamp - lastFrameTime) / 1000;
    lastFrameTime = timestamp;

    const track = document.getElementById('tickerTrack');
    if (!track || tickerContentWidth === 0) {
        tickerAnimation = requestAnimationFrame(animateTicker);
        return;
    }

    tickerOffset += TICKER_SPEED * dt;

    // Когда первый набор полностью ушёл — возвращаемся в начало
    if (tickerOffset >= tickerContentWidth) {
        tickerOffset -= tickerContentWidth;
    }

    // Стартуем справа за пределами экрана и едем влево
    const viewport = track.parentElement.clientWidth;
    const startX = viewport;
    track.style.transform = `translateX(${startX - tickerOffset}px)`;

    tickerAnimation = requestAnimationFrame(animateTicker);
}

